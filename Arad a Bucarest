def algoritmo_a_estrella(grafo, heuristica, inicio, Final):
    lista_abierta = [inicio]      # rutas ya concoidas pero sin usar
    lista_cerrada = set()         #ya usadas
    rastros = {}                  #rastros[ciudad] = de donde vengo
    #----------------------------------------
    #g(n): costo real para alcanzar el nodo |
    # ---------------------------------------
    costo_g = {inicio: 0}


    # ------------------------------------------
    # f(n): costo total estimado (g(n) + h(n)) |
    # ------------------------------------------
    costo_f = {inicio: heuristica[inicio]}

    #funcion normal que le dice a "min()" con que val comparar comparar
    def obtener_costo_f(ciudad):
        return costo_f.get(ciudad, float('inf'))

    while lista_abierta:
                #NO le pongas el  parentesis, SOLO el nombre
        ciudad_actual = min(lista_abierta, key=obtener_costo_f)

        # aqui rehaces la ruta en reversa
        if ciudad_actual == Final:
            ruta = [ciudad_actual]
            while ciudad_actual in rastros:
                ciudad_actual = rastros[ciudad_actual]
                ruta.append(ciudad_actual)
            ruta.reverse()
            return ruta, costo_g[Final]

        #cehcar bien para que se hacee esto
        lista_abierta.remove(ciudad_actual)
        lista_cerrada.add(ciudad_actual)

        #revisas vecinos
        for vecino, peso in grafo.get(ciudad_actual, {}).items(): #el .get solo es un cuidado por si no tiene vecionod
            if vecino in lista_cerrada:
                continue

            g_nuevo = costo_g[ciudad_actual] + peso

            #este camino es mucho mas mejor que el anterior?
            if g_nuevo < costo_g.get(vecino, float('inf')):
                rastros[vecino] = ciudad_actual
                costo_g[vecino] = g_nuevo
                costo_f[vecino] = g_nuevo + heuristica[vecino]
                if vecino not in lista_abierta:
                    lista_abierta.append(vecino)

    return None, float('inf')  #se vacio la lista


#basicamente el programa
ruta, costo = algoritmo_a_estrella(grafo, heuristica, 'Arad', 'Bucarest')

