import random

print("Selecciona un modo")
print("1: aleatorio")
print("2: por mitades")

while True:
    modo = input("selecciona un modo: ")
    if modo == "1" or modo == "2":
        break
    print("solo 1 o 2")

numero_secreto = random.randint(1, 100)
intentos = 0

# el rango del numero secreto
minimo = 1
maximo = 100

print("")
print("El numero secreto es:", numero_secreto)
print("")

# ---------------- ALEATORIO ----------------
if modo == "1":

    aleatorio2 = random.randint(minimo, maximo)

    while True:
        intentos = intentos + 1
        print("Intento", intentos, "- el programa dice:", aleatorio2)

        if aleatorio2 < numero_secreto:
            # el num es mayor, entonces el minimo debe subir
            minimo = aleatorio2 + 1

            aleatorio2 = random.randint(minimo, maximo)
        elif aleatorio2 > numero_secreto:
            # es menor entonces el maximo baja
            maximo = aleatorio2 - 1

            aleatorio2 = random.randint(minimo, maximo)
        else:
            print("ealeeee si era eseeee", numero_secreto)
            print("Lo logro en:", intentos, "intentos")
            break

# ---------------- MITADES ----------------
else:
    # primero es la mitad de 1 a 100
    medio = (minimo + maximo) // 2

    while True:
        intentos = intentos + 1
        print("Intento", intentos, "- el programa dice:", medio)

        if medio < numero_secreto:
            # el num es mayor, entonces el minimo debe subir
            minimo = medio + 1
            medio = (minimo + maximo) // 2
        elif medio > numero_secreto:
            # el maximo baja
            maximo = medio - 1
            medio = (minimo + maximo) // 2
        else:
            print("ealeeee si era eseeee", numero_secreto)
            print("Lo logro en", intentos, "intentos")
            break
