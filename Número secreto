import random

numero_secreto = random.randint(1, 100)
intentos = 0

print("adivina el numero entre 1 y 100")

while True:
    num_ingresado = input("tu número: ")

    #por si el chango escribe letras
    if not num_ingresado.isdigit():
        print("Coloca un numero por favor...")
        continue

    numero_jugador = int(num_ingresado)
    intentos = intentos + 1

    #comparar con numero secreto
    if numero_jugador < numero_secreto:
        print("Es mayor intenta de nuevo")
    elif numero_jugador > numero_secreto:
        print("Es menor intenta de nuevo")
    else:
        print("ealeeee si era eseeee", numero_secreto)
        print("Lo lograste en", intentos, "intentos")
        break
